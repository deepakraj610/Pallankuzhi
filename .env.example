# Copy to .env and replace placeholders. Never commit .env.
DB_USER=postgres
# Required, no default. Choose a strong password.
DB_PASSWORD=
DB_NAME=pallankuzhi
# Local (non-docker) use only; keep the password in sync with DB_PASSWORD.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/pallankuzhi
# Required: at least 32 characters (shorter keys are rejected).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Intentionally empty: the placeholder must not be a usable key.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Optional: override the Google OAuth redirect URI (empty = backend default).
OAUTH_REDIRECT_URI=
VITE_API_URL=http://localhost:8000
